---
interface Props {
  type?: 'fade-up' | 'fade-in' | 'slide-left' | 'slide-right' | 'scale-in' | 'bounce-in' | 'rotate-in';
  delay?: number;
  duration?: number;
  class?: string;
}

const { type = 'fade-up', delay = 0, duration = 700, class: className = '' } = Astro.props;
---

<!-- Content is visible in the HTML; animation is an optional enhancement. -->
<div class={className} data-animate={type} data-delay={delay} data-duration={duration}>
  <slot />
</div>

<script>
  const setupAnimations = () => {
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !('IntersectionObserver' in window) ||
      !('animate' in Element.prototype)
    ) return;

    const initialTransforms: Record<string, string> = {
      'fade-up': 'translateY(16px)',
      'fade-in': 'none',
      'slide-left': 'translateX(32px)',
      'slide-right': 'translateX(-32px)',
      'scale-in': 'scale(0.95)',
      'bounce-in': 'scale(0.5)',
      'rotate-in': 'rotate(12deg) scale(0.95)',
    };

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        const element = entry.target as HTMLElement;
        // Keep direct links and keyboard navigation stable while reading a section.
        if (element.contains(document.activeElement) || element.querySelector(':target') || element.matches(':target')) continue;
        element.animate([
          { opacity: 0, transform: initialTransforms[element.dataset.animate ?? 'fade-up'] ?? 'none' },
          { opacity: 1, transform: 'none' },
        ], {
          duration: Number(element.dataset.duration),
          delay: Number(element.dataset.delay),
          easing: 'ease-out',
          fill: 'backwards',
        });
      }
    }, { threshold: 0, rootMargin: '0px 0px -50px 0px' });

    document.querySelectorAll<HTMLElement>('[data-animate]').forEach(element => observer.observe(element));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAnimations, { once: true });
  } else {
    setupAnimations();
  }
</script>
