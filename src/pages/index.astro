---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Animate from '../components/Animate.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';
import { sparProject, saigeProject } from '../data/research';

const title = `${profile.name} — ${profile.headline}`;
const description = `${profile.name}. ${profile.bio}`;
---

<BaseLayout title={title} description={description} pageType="ProfilePage">
  <Navigation />

  <!-- Main Content -->
  <main class="min-h-screen">
    <div class="container-custom py-8 md:py-12">

      <!-- Hero Content Card -->
      <Animate type="fade-up" delay={100}>
        <div class="bg-white rounded-lg shadow-xs p-8 md:p-12 border border-gray-100">
          <div class="grid lg:grid-cols-2 gap-12 items-center">

            <!-- Content -->
            <div class="space-y-6">
              <div>
                <p class="text-sm font-medium text-primary-600 mb-3">{profile.headline}</p>
                <h1 class="text-3xl md:text-4xl font-semibold mb-6">{profile.name}</h1>
                <h2 class="sr-only">About</h2>
                <div class="text-lg text-gray-700 leading-relaxed space-y-4">

<p>
I'm a <strong>{profile.role}</strong>, fascinated by systems of all kinds: biological, social, technological. How they work, why they fail, how they solve information flow and how we might design better ones.
</p>

<p>
Professionally, that means building software and working with data, mostly around machine learning and complex system modeling - business or elsewhere. The Skills section has a more detailed overview if you are interested in potential collaborations.
</p>
<p>
The rest of this place collects my interests and outputs.
I publish my writing as {profile.alternateName}.
A lot is me talking to myself, trying to understand things better by writing them down. <br />
</p>
<p>
I'd say the main themes are philosophy and ethics, social theory and management of complexity. <br />
</p>
<p>
I'm based in Berlin, where I also research AI's economic implications: how we make decisions under uncertainty and how technological progress shapes the futures we face.
</p>
                </div>
              </div>

              <!-- CTA Buttons -->
              <div class="flex flex-wrap gap-4 pt-4">
                <a href="/skills/" class="btn btn-outline">Skills &amp; experience</a>
                <a href="/projects/" class="btn btn-outline">Research &amp; projects</a>
                <a
                  href="mailto:p.petermeier@posteo.de"
                  class="btn btn-outline"
                >
                  Get In Touch
                </a>
                <a
                  href="/uploads/CV_for_Website.pdf"
                  class="btn btn-outline group relative overflow-hidden"
                  download
                  target="_blank"
                >
                  <span class="relative z-10 flex items-center gap-2">
                    <Icon name="mdi:file-download" size={20} />
                    Download CV
                  </span>
                  <div
                    class="absolute inset-0 opacity-0 group-hover:opacity-100 animate-shimmer bg-gradient-to-r from-transparent via-white/30 to-transparent transition-opacity"
                    style="background-size: 200% 100%;"
                  ></div>
                </a>
              </div>
            </div>

            <!-- Profile Image -->
            <div class="flex justify-center lg:justify-end">
              <Animate type="scale-in" delay={200}>
                <div class="relative">
                  <div class="w-56 h-56 md:w-64 md:h-64 rounded-full bg-gradient-to-br from-primary-400 via-primary-600 to-orange-500 p-1 hover:scale-105 transition-transform duration-300">
                    <img
                      src={profile.avatar}
                      alt={profile.name}
                      class="w-full h-full rounded-full object-cover object-top"
                    />
                  </div>
                </div>
              </Animate>
            </div>
          </div>
        </div>
      </Animate>

      <section aria-labelledby="recent-research-heading" class="mt-8 md:mt-12">
        <Animate type="fade-up">
          <div class="bg-white rounded-lg shadow-xs p-8 md:p-12 border border-gray-100">
            <h2 id="recent-research-heading" class="text-3xl font-semibold mb-8">Current &amp; recent research</h2>
            <div class="grid md:grid-cols-2 gap-8">
              <article class="min-w-0 flex flex-col">
                <p class="text-sm font-medium text-primary-600 mb-3">{sparProject.period} · {sparProject.status}</p>
                <h3 class="text-xl font-semibold mb-4">
                  Current — {sparProject.programme}
                </h3>
                <p class="mb-5 flex-grow">{sparProject.summary}</p>
                <div class="flex flex-wrap gap-4">
                  <a href={sparProject.path} class="btn btn-outline">About the SPAR project</a>
                </div>
              </article>
              <article class="min-w-0 flex flex-col border-t border-gray-200 pt-8 md:border-t-0 md:border-l md:pt-0 md:pl-8">
                <p class="text-sm font-medium text-primary-600 mb-3">{saigeProject.period} · {saigeProject.status}</p>
                <h3 class="text-xl font-semibold mb-4">
                  {saigeProject.status} — {saigeProject.programme}
                </h3>
                <p class="mb-5 flex-grow">{saigeProject.summary}</p>
                <div class="flex flex-wrap gap-4">
                  <a href={saigeProject.report.url} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Read project report</a>
                  <a href={saigeProject.path} class="btn btn-outline">About the project</a>
                </div>
              </article>
            </div>
          </div>
        </Animate>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>
