---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';

const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/skills/', label: 'Skills' },
  { href: '/projects/', label: 'Projects' },
];
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
const getLinkClasses = (href: string) => `block py-2 px-3 rounded-md transition-colors ${
  isActive(href)
    ? 'bg-primary-100 text-primary-700 font-semibold'
    : 'text-gray-700 hover:text-primary-600 hover:bg-primary-50'
}`;
---

<nav aria-label="Main navigation" class="bg-white shadow-xs border-b border-gray-100 sticky top-0 z-50">
  <div class="container-custom">
    <div class="flex justify-between items-center py-4">
      <a href="/" class="flex flex-col hover:opacity-80 transition-opacity">
        <span class="text-xl font-bold text-gray-900">{profile.name}</span>
        <span class="text-xs text-gray-500 font-normal">infornomics.de</span>
      </a>

      <div class="hidden md:flex items-center space-x-2">
        {navItems.map(item => (
          <a href={item.href} class={getLinkClasses(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a href="/uploads/CV_for_Website.pdf" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 py-2 px-3 rounded-md text-gray-700 hover:text-primary-600 hover:bg-primary-50 transition-colors font-medium" aria-label="Download CV">
          <Icon name="mdi:file-document" size={20} />
          CV
        </a>
        <div class="flex items-center space-x-2 ml-4">
          {profile.profiles.map(social => (
            <a href={social.url} target={social.url.startsWith('http') ? '_blank' : undefined} rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined} class="icon-fade p-2 rounded-md text-gray-500 hover:text-primary-600 hover:bg-primary-50 transition-colors" aria-label={social.label}>
              <Icon name={social.icon} size={20} />
            </a>
          ))}
        </div>
      </div>

      <!-- Native disclosure keeps mobile navigation usable without JavaScript. -->
      <details class="mobile-menu md:hidden">
        <summary class="list-none cursor-pointer p-2 rounded-md text-gray-700 hover:text-primary-600 focus-visible:outline-2 focus-visible:outline-primary-500" aria-label="Navigation menu">
          <Icon name="mdi:menu" size={24} />
        </summary>
        <div class="absolute inset-x-0 top-full bg-white border-b border-gray-100 shadow-xs">
          <div class="container-custom py-4 space-y-2">
            {navItems.map(item => (
              <a href={item.href} class={getLinkClasses(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
            <a href="/uploads/CV_for_Website.pdf" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 py-2 px-3 rounded-md text-gray-700 hover:text-primary-600 hover:bg-primary-50 transition-colors font-medium" aria-label="Download CV">
              <Icon name="mdi:file-document" size={20} />
              CV
            </a>
            <div class="flex space-x-2 pt-2">
              {profile.profiles.map(social => (
                <a href={social.url} target={social.url.startsWith('http') ? '_blank' : undefined} rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined} class="icon-fade p-2 rounded-md text-gray-500 hover:text-primary-600 hover:bg-primary-50 transition-colors" aria-label={social.label}>
                  <Icon name={social.icon} size={20} />
                </a>
              ))}
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</nav>

<style>
  summary::-webkit-details-marker { display: none; }
  .icon-fade:hover :global(svg),
  .icon-fade:focus-visible :global(svg) { opacity: 0.7; }
</style>
